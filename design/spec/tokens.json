{
  "$schema": "https://open-design.local/schema/design-tokens-v1.json",
  "meta": {
    "product": "Volna file manager",
    "specVersion": "1.6",
    "date": "2026-11-17",
    "canonicalArtifact": "design/artifacts/variant-c.html",
    "direction": "C — Dolphin x JetBrains",
    "locale": "ru-RU",
    "mode": "dark"
  },
  "themes": {
    "dark": {
      "color": {
        "bg": {
          "canvas": "#1e1f22",
          "chrome": "#2b2d30",
          "chromeAlt": "#26282d",
          "inset": "#1e1f22"
        },
        "border": {
          "gap": "#1e1f22",
          "line": "#393b40",
          "field": "#393b40"
        },
        "text": {
          "primary": "#dfe1e5",
          "secondary": "#9da0a8",
          "muted": "#6f737a",
          "onAccent": "#ffffff"
        },
        "icon": {
          "primary": "#ced0d6",
          "secondary": "#6f737a"
        },
        "accent": {
          "state": "#3574f0",
          "soft": "#25324d"
        },
        "state": {
          "hover": "#393b40",
          "selected": "#43454a",
          "selectedFocused": "#1d2432",
          "scrollbar": "#5b5d5f"
        },
        "semantic": {
          "error": "#db5c5c",
          "warning": "#f2c55c",
          "success": "#57965c"
        },
        "content": {
          "folderBody": "#4a88d8",
          "folderLight": "#7fb2ec",
          "deviceUsageTrack": "#3c3f44",
          "deviceUsageFill": "#db5c5c"
        }
      }
    },
    "lightReference": {
      "note": "Реализовано в variant-b.html; для будущей light-темы C",
      "color": {
        "bg": {
          "canvas": "#ffffff",
          "chrome": "#f7f8fa",
          "chromeAlt": "#f2f3f5",
          "toolbar": "#27282d"
        },
        "border": {
          "gap": "#dfe1e5",
          "line": "#ebecf0"
        },
        "text": {
          "primary": "#000000",
          "secondary": "#6d707d",
          "disabled": "#a8adbd",
          "onAccent": "#ffffff"
        },
        "icon": {
          "primary": "#6c707e",
          "secondary": "#818594"
        },
        "accent": {
          "state": "#3574f0",
          "soft": "#e7effd"
        },
        "state": {
          "hover": "#eceff1",
          "selected": "#dfe1e5",
          "selectedFocused": "#e9eef9",
          "scrollbar": "#c4c4c4"
        },
        "semantic": {
          "error": "#db3b4b",
          "warning": "#e6a817",
          "success": "#208a3c"
        }
      }
    }
  },
  "typography": {
    "font": {
      "ui": "'Inter','JetBrains Sans',system-ui,-apple-system,'Segoe UI',sans-serif",
      "mono": "'JetBrains Mono',ui-monospace,'SF Mono',Menlo,Consolas,monospace"
    },
    "scale": {
      "caption": { "size": 12, "lineHeight": 1.2, "weight": 400 },
      "sectionTitle": { "size": 12, "lineHeight": 1.2, "weight": 600, "letterSpacing": "0.02em" },
      "meta": { "size": 13, "lineHeight": 1.3, "weight": 400 },
      "body": { "size": 14, "lineHeight": 1, "weight": 400 },
      "bodyMedium": { "size": 14, "lineHeight": 1, "weight": 500 },
      "bodySemibold": { "size": 14, "lineHeight": 1.2, "weight": 600 },
      "itemName": { "size": 13.5, "lineHeight": 1.25, "weight": 400 },
      "tileName": { "size": 13.5, "lineHeight": 1.3, "weight": 400, "clampLines": 2 },
      "cardTitle": { "size": 17, "lineHeight": 1.3, "weight": 600 },
      "mono": { "size": 13, "lineHeight": 1.3, "weight": 400, "family": "mono" }
    }
  },
  "spacing": {
    "base": 4,
    "steps": [2, 4, 6, 8, 10, 12, 14, 16],
    "toolbarPaddingX": 8,
    "toolbarGroupGap": 8,
    "popoverPadding": 12,
    "panelPaddingX": 8,
    "editorToolbarPaddingX": 8,
    "statusPaddingX": 8
  },
  "shape": {
    "radius": {
      "control": 4,
      "tile": 6,
      "segment": 6,
      "popover": 8,
      "window": 8
    },
    "borderWidth": 1,
    "accentUnderline": 3,
    "progressBar": 4,
    "zoomTrack": 4
  },
  "sizes": {
    "window": { "width": 1440, "height": 900 },
    "toolbar": 40,
    "headerBand": 40,
    "workspace": 608,
    "editorToolbar": 32,
    "band": 576,
    "bottomWindow": 180,
    "bottomHeader": 40,
    "bottomContent": 140,
    "statusBar": 28,
    "rail": 40,
    "leftPanel": 280,
    "rightPanel": 300,
    "row": 24,
    "treeRow": 24,
    "tabHeight": 40,
    "tabMaxWidth": 220,
    "popoverWidth": 320,
    "popoverMaxHeight": 820,
    "iconButton": 24,
    "railButton": 32,
    "toolbarWidgetHeight": 28,
    "filterField": { "width": 200, "height": 24 },
    "pathField": { "height": 24 },
    "viewRow": 26,
    "viewRadioBox": 14,
    "viewSegment": 24,
    "zoomSlider": { "width": 96, "height": 14, "thumb": 10, "track": 4 },
    "column": { "width": 236, "minWidth": 190, "headerHeight": 28, "itemHeight": 62 },
    "iconTile": { "minWidth": 150, "maxWidth": 178, "minHeight": 150 },
    "detailsTable": { "headerHeight": 28, "groupHeight": 28, "rowHeight": 24, "columns": "minmax(0,1fr) 96px 168px 76px" },
    "inspector": { "cardIcon": 64, "metaRow": 24, "button": 32 },
    "presets": {
      "fieldHeight": 28,
      "saveButton": 28,
      "listRow": 26,
      "listMaxHeight": 174,
      "actionButton": 22,
      "actionIcon": 14,
      "dialog": { "width": 380, "padding": 16, "inputHeight": 28, "listRow": 24, "button": 32 },
      "deleteDialog": { "width": 380, "button": 32 }
    },
    "deviceUsageBar": 3
  },
  "density": {
    "regular": {
      "columnItemHeight": 66,
      "columnPadding": "6px 8px",
      "tileMinHeight": 150,
      "folderIcon": 48,
      "detailsRowHeight": 24,
      "detailsFont": 13.5
    },
    "compact": {
      "columnItemHeight": 54,
      "columnPadding": "2px 8px",
      "tileMinHeight": 132,
      "folderIcon": 40,
      "detailsRowHeight": 24,
      "detailsFont": 13
    }
  },
  "sizeVariants": {
    "default": "wide",
    "compact": { "scale": 1, "window": { "width": 1440, "height": 900 } },
    "wide": { "scale": 1.25, "window": { "width": 1800, "height": 1125 } },
    "note": "Все размеры умножаются на scale, кроме 1px линий и радиусов; плотность (density) — независимая ось."
  },
  "zoom": {
    "range": [0, 100],
    "default": 50,
    "formula": {
      "columnWidth": "s <= 50 ? 200 + s*0.72 : 236 + (s-50)*0.88",
      "columnIcon": "ceil(40 + s*0.16)",
      "tileIcon": "round(48 + s*0.24)",
      "percent": "round(85 + s*0.3)"
    }
  },
  "motion": {
    "duration": { "state": 120 },
    "easing": "ease",
    "animatedProperties": ["background-color", "color", "border-color"],
    "reducedMotion": "disable transitions"
  },
  "elevation": {
    "insideWindow": "none",
    "windowShadow": "0 30px 90px rgba(0,0,0,.62), 0 6px 18px rgba(0,0,0,.45)",
    "popoverShadow": "0 12px 32px rgba(0,0,0,.5)",
    "menuShadow": "0 8px 24px rgba(0,0,0,.45)"
  },
  "layers": {
    "band": 1,
    "stickyTableHeader": 2,
    "menu": 40,
    "viewPopover": 60,
    "presetModal": 70,
    "presetDeleteModal": 75,
    "closedState": 80
  },
  "features": {
    "presets": {
      "persisted": true,
      "storageKey": "volna.presets.v1",
      "builtinPresets": ["По умолчанию", "Плотный список", "Крупные значки", "Без группировки"]
    }
  },
  "icons": {
    "grid": { "action": 16, "rail": 20, "indicator": 14, "small": 12 },
    "stroke": 1.5,
    "style": "outline, rounded caps, currentColor",
    "folderSizes": { "row": 16, "compactColumn": 40, "column": 48, "tile": 60, "inspector": 64 }
  }
}
